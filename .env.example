# Copia este archivo a .env para correr en local.
# En Railway NO subas este archivo: pon estas variables en el panel de Railway.
PORT=3000
# En local déjalo vacío para usar SQLite (archivo data/robin-dark.db).
# En Railway, el plugin de Postgres crea DATABASE_URL automáticamente.
DATABASE_URL=
# Cambia esto en producción por una cadena larga y secreta (mínimo 32
# caracteres). En producción (con DATABASE_URL) el servidor NO arranca
# sin un JWT_SECRET fuerte: ya no hay secreto por defecto en el código.
JWT_SECRET=cambia-esta-clave-secreta-en-produccion
# Dueño del sitio (opcional): el alias de tu cuenta. Esa cuenta
# lleva la insignia especial «Admin» y el ✓ Verificado, y es la
# única que puede aprobar las solicitudes de verificación desde
# su propio perfil. No hay panel de administrador ni contraseña
# de admin: el dueño entra como un usuario más.
ADMIN_ALIAS=admin

# Correo de verificación y recuperación de contraseña (Resend).
# OBLIGATORIA en producción: sin RESEND_API_KEY no se envía
# ningún código, y como el login queda bloqueado hasta confirmar
# el correo, nadie podría entrar. En local y en los tests no hace
# falta (el registro funciona igual pero el código no se envía y
# "¿Olvidaste tu contraseña?" responde siempre lo mismo sin mandar
# nada; el cliente lo sabe por GET /api/auth/config). Con la llave,
# los códigos de 6 dígitos llegan de verdad desde
# noreply@robindark.co. La llave va SOLO aquí (o en Variables de
# Railway), nunca en el código.
# RESEND_API_URL solo existe para las pruebas locales (apunta a un
# servidor falso de Resend); nunca se pone en producción.
RESEND_API_KEY=
# RESEND_API_URL=http://127.0.0.1:3499/emails
# Fotos y vídeos (avatar, portada, documento, posts, historias, reels).
# PHOTO_STORAGE=db (por defecto): los bytes van a la tabla photos.
# Funciona sin crear ninguna cuenta ni poner ninguna llave.
# PHOTO_STORAGE=r2: Cloudflare R2. Si falta alguna variable R2_*,
# se avisa por consola y se usa 'db' (las fotos nunca dejan de
# funcionar por falta de R2). R2_PUBLIC_URL es opcional: si se pone,
# las fotos públicas se sirven directas desde R2.
PHOTO_STORAGE=db
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Límites de velocidad (opcionales; en producción valen los valores
# por defecto): 300 peticiones / 15 min por IP en la API, 10 intentos
# de login/registro, 5 de admin, 5 de recuperación y 60 preguntas a
# la IA. Se suben en local para las pruebas automatizadas.
# RATE_LIMIT_API_MAX=300
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_ADMIN_MAX=5
# RATE_LIMIT_RECOVERY_MAX=5
# RATE_LIMIT_AI_MAX=60
