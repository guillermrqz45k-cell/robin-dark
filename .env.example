# Copia este archivo a .env para correr en local.
# En Railway NO subas este archivo: pon estas variables en el panel de Railway.
PORT=3000
# En local déjalo vacío para usar SQLite (archivo data/robin-dark.db).
# En Railway, el plugin de Postgres crea DATABASE_URL automáticamente.
DATABASE_URL=
# Cambia esto en producción por una cadena larga y secreta (mínimo 32
# caracteres). En producción (con DATABASE_URL) el servidor NO arranca
# sin un JWT_SECRET fuerte: ya no hay secreto por defecto en el código.
JWT_SECRET=cambia-esta-clave-secreta-en-produccion
# Panel de administrador (opcional, pero necesario para entrar a /Admin).
# El dueño pone aquí su alias y una contraseña larga y secreta.
# SIN estas dos variables, el login de admin no funciona (responde 503):
# no hay ninguna contraseña por defecto en el código.
ADMIN_ALIAS=admin
ADMIN_PASSWORD=pon-aqui-una-contrasena-larga-y-secreta
# Pagos con tarjeta (Stripe, opcional): sin estas claves, el cobro con
# tarjeta responde 503 y las recargas quedan pendientes para que el
# admin las revise a mano. Con claves, el usuario paga en Stripe
# Checkout y el webhook acredita el saldo. La URL pública de la app
# (para volver tras el pago) se toma de APP_URL o del host.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=
