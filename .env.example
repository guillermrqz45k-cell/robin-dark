# Copia este archivo a .env para correr en local.
# En Railway NO subas este archivo: pon estas variables en el panel de Railway.
PORT=3000
# En local déjalo vacío para usar SQLite (archivo data/robin-dark.db).
# En Railway, el plugin de Postgres crea DATABASE_URL automáticamente.
DATABASE_URL=
# Cambia esto en producción por una cadena larga y secreta.
JWT_SECRET=cambia-esta-clave-secreta-en-produccion
